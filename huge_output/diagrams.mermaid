%% 9. ACTIVITY DIAGRAM
graph TD
    Start([Start: executeTransfer]) --> CheckNull{source == null || target == null}
    CheckNull -->|Yes| ReturnFalse([Return false])
    CheckNull -->|No| CheckActive{status == ACTIVE?}
    CheckActive -->|No| ReturnFalse
    CheckActive -->|Yes| CheckAmount{amount > 0?}
    CheckAmount -->|No| ReturnFalse
    CheckAmount -->|Yes| DoWithdraw{source.withdraw(amount)}
    DoWithdraw -->|Success| DoDeposit[target.deposit(amount)] --> ReturnTrue([Return true])
    DoWithdraw -->|Failure| ReturnFalse


%% 10. STATE MACHINE DIAGRAM
stateDiagram-v2
    [*] --> UNVERIFIED : UserAccount()
    UNVERIFIED --> ACTIVE : setStatus(ACTIVE)
    ACTIVE --> FROZEN : setStatus(FROZEN)
    ACTIVE --> CLOSED : setStatus(CLOSED)
    FROZEN --> ACTIVE : setStatus(ACTIVE)
    CLOSED --> [*]


%% 11. SEQUENCE DIAGRAM
sequenceDiagram
    autonumber
    actor App as MainApplication
    participant Config as DatabaseConfig
    participant Savings as SavingsAccount
    participant Checking as CheckingAccount
    participant Tx as LedgerTransaction
    participant Svc as TransferService

    App->>Config: getInstance()
    Config-->>App: dbConfig
    App->>Savings: applyInterest()
    Savings->>Savings: deposit(interestAmount)
    App->>Svc: executeTransfer(savings, checking, tx)
    Svc->>Savings: getStatus()
    Savings-->>Svc: AccountStatus.ACTIVE
    Svc->>Checking: getStatus()
    Checking-->>Svc: AccountStatus.ACTIVE
    Svc->>Savings: withdraw(450.0)
    Savings-->>Svc: true
    Svc->>Checking: deposit(450.0)
    Svc-->>App: true


