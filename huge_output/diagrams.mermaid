%% 9. ACTIVITY DIAGRAM
graph TD
    Start([Start: processTransaction]) --> CondNull{source == null || target == null}
    CondNull -->|Yes| Fail1([Return false])
    CondNull -->|No| CondStatus{status == ACTIVE?}
    CondStatus -->|No| SetErr[tx.setStatus(ERROR)] --> Fail1
    CondStatus -->|Yes| CondAmt{amount > 0?}
    CondAmt -->|No| SetErr
    CondAmt -->|Yes| ExecWithdraw{source.withdraw(amount)}
    ExecWithdraw -->|Success| Deposit[target.deposit(amount)] --> SetClose[tx.setStatus(CLOSED)] --> Pass([Return true])
    ExecWithdraw -->|Failure| SetSusp[tx.setStatus(SUSPENDED)] --> Fail1


%% 10. STATE MACHINE DIAGRAM
stateDiagram-v2
    [*] --> PENDING : createTransaction()
    PENDING --> ACTIVE : validateAccount()
    ACTIVE --> CLOSED : processTransaction() [withdraw == true]
    ACTIVE --> SUSPENDED : processTransaction() [insufficient balance]
    ACTIVE --> ERROR : processTransaction() [status != ACTIVE]
    CLOSED --> [*]
    SUSPENDED --> [*]
    ERROR --> [*]


%% 11. SEQUENCE DIAGRAM
sequenceDiagram
    autonumber
    actor App as Application
    participant Config as SystemConfig
    participant Proc as TransactionProcessor
    participant Acc1 as SourceAccount
    participant Acc2 as TargetAccount
    participant Tx as Transaction

    App->>Config: getInstance()
    Config-->>App: configInstance
    App->>Proc: processTransaction(acc1, acc2, tx)
    Proc->>Acc1: getStatus()
    Acc1-->>Proc: StatusEnum.ACTIVE
    Proc->>Acc2: getStatus()
    Acc2-->>Proc: StatusEnum.ACTIVE
    Proc->>Acc1: withdraw(350.0)
    Acc1-->>Proc: true
    Proc->>Acc2: deposit(350.0)
    Proc->>Tx: setStatus(StatusEnum.CLOSED)
    Proc-->>App: true


%% 12. COMMUNICATION DIAGRAM
graph LR
    App["1: Application"] -->|1.1: getInstance()| Config["SystemConfig"]
    App -->|1.2: processTransaction()| Proc["TransactionProcessor"]
    Proc -->|1.2.1: withdraw()| Acc1["Source Account"]
    Proc -->|1.2.2: deposit()| Acc2["Target Account"]
    Proc -->|1.2.3: setStatus()| Tx["Transaction"]


