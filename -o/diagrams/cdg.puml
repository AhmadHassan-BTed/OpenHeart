@startuml
skinparam backgroundColor transparent
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName "Space Grotesk", "Segoe UI", sans-serif
skinparam defaultFontColor #e5e5e5
skinparam defaultFontSize 12
skinparam ArrowColor #38bdf8
skinparam ArrowThickness 1.5
skinparam packageStyle rectangle
skinparam PackageBorderColor #facc15
skinparam PackageBackgroundColor #0f141c
skinparam PackageFontColor #facc15
skinparam ClassBorderColor #38bdf8
skinparam ClassBackgroundColor #14171f
skinparam ClassHeaderBackgroundColor #1e2433
skinparam ClassFontColor #ffffff
skinparam ObjectBorderColor #38bdf8
skinparam ObjectBackgroundColor #14171f
skinparam ObjectFontColor #ffffff
skinparam ComponentBorderColor #38bdf8
skinparam ComponentBackgroundColor #14171f
skinparam ComponentFontColor #ffffff
skinparam NodeBorderColor #38bdf8
skinparam NodeBackgroundColor #14171f
skinparam NodeFontColor #ffffff
skinparam StateBorderColor #38bdf8
skinparam StateBackgroundColor #14171f
skinparam StateFontColor #ffffff
skinparam ActivityBorderColor #38bdf8
skinparam ActivityBackgroundColor #14171f
skinparam ActivityFontColor #ffffff
skinparam SequenceLifeLineBorderColor #38bdf8
skinparam SequenceLifeLineBackgroundColor #14171f
skinparam SequenceGroupBorderColor #facc15
skinparam SequenceGroupBackgroundColor #0f141c
skinparam SequenceGroupFontColor #facc15
skinparam ParticipantBorderColor #38bdf8
skinparam ParticipantBackgroundColor #14171f
skinparam ParticipantFontColor #ffffff
skinparam ActorBorderColor #facc15
skinparam ActorBackgroundColor #14171f
skinparam ActorFontColor #ffffff
skinparam UsecaseBorderColor #38bdf8
skinparam UsecaseBackgroundColor #14171f
skinparam UsecaseFontColor #ffffff

title Control Dependence Graph (CDG) & Condition Gates

state "Entry Root Gate (START)" as CDG_Root #1e293b
state "Condition Gate 1: (amount > 0)" as Gate_1 <<choice>>
state "Controlled Block: repository.saveOrder()" as Stmt_1 #14171f
state "Controlled Block: return response" as Stmt_2 #14171f

CDG_Root --> Gate_1 : unconditional_control
Gate_1 --> Stmt_1 : [true_guard]
CDG_Root --> Stmt_2 : unconditional_control
@enduml
