@startuml
skinparam backgroundColor transparent
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName "Space Grotesk", "Segoe UI", sans-serif
skinparam defaultFontColor #e5e5e5
skinparam defaultFontSize 12
skinparam ArrowColor #38bdf8
skinparam ArrowThickness 1.5

card "v0: SourceManifest" as v0 {
  type: SourceManifest
  def: param(manifest)
}

card "v1: TokenCorpusArtifact" as v1 {
  type: TokenCorpusArtifact
  def: ingest(v0)
}

card "v2: BPASTArtifact" as v2 {
  type: BPASTArtifact
  def: reduce_cst(v1)
}

card "v3: SymbolTableArtifact" as v3 {
  type: SymbolTableArtifact
  def: resolve_symbols(v1, v2)
}

card "v4: CFGArtifact" as v4 {
  type: CFGArtifact
  def: cooper_dominators(v2, v3)
}

card "v5: PathsArtifact" as v5 {
  type: PathsArtifact
  def: robdd_saturation(v4)
}

card "v6: SCPGArtifact" as v6 {
  type: SCPGArtifact
  def: synthesize_scpg(v3, v4, v5)
}

v0 --> v1 : use: manifest
v1 --> v2 : use: tokens
v1 --> v3 : use: strings
v2 --> v3 : use: nodes
v2 --> v4 : use: ast
v3 --> v4 : use: scopes
v4 --> v5 : use: frontiers
v3 --> v6 : use: type_hierarchy
v4 --> v6 : use: cfg_blocks
v5 --> v6 : use: saturated_bdd

@enduml
