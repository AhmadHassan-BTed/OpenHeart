@startuml
skinparam backgroundColor transparent
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName "Space Grotesk", "Segoe UI", sans-serif
skinparam defaultFontColor #e5e5e5
skinparam defaultFontSize 12
skinparam ArrowColor #38bdf8
skinparam ArrowThickness 1.5
skinparam packageStyle rectangle
skinparam PackageBorderColor #facc15
skinparam PackageBackgroundColor #0f141c
skinparam PackageFontColor #facc15

package "com.openheart.core" as core
package "com.openheart.ingestion" as ingestion
package "com.openheart.symbol" as symbol
package "com.openheart.cfg" as cfg
package "com.openheart.ssa" as ssa
package "com.openheart.psa" as psa
package "com.openheart.uma" as uma
package "com.openheart.scpg" as scpg

ingestion ..> core : <<use>>
symbol ..> ingestion : <<use>>
cfg ..> symbol : <<use>>
ssa ..> cfg : <<use>>
psa ..> ssa : <<use>>
uma ..> psa : <<use>>
scpg ..> uma : <<use>>

@enduml
