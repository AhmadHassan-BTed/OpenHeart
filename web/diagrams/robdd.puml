title Reduced Ordered BDD (ROBDD) & Shannon Decision Gates

state "ROBDD Path Summary: Image_DataInitializer_Factory.createDataInitializer()\n[#SAT Paths: 2 | Cyclomatic V(G): 1]" as BDD_Image_DataInitializer_Factory_createDataInitializer {
  state "Gate x₀ (Branch 0)" as Node_x0 <<choice>>
  state "Gate x₁ (Branch 1)" as Node_x1 <<choice>>
  state "1 (Feasible Path)" as Term_1 #065f46
  state "0 (Infeasible Sink)" as Term_0 #7f1d1d

  [*] --> Node_x0
  Node_x0 --> Node_x1 : [x₀ = 1] (high/solid)
  Node_x0 ..> Term_0 : [x₀ = 0] (low/dashed)
  Node_x1 --> Term_1 : [x₁ = 1] (feasible path)
  Node_x1 ..> Term_0 : [x₁ = 0] (infeasible path)
}

