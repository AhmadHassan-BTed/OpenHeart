@startuml
skinparam backgroundColor transparent
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName "Space Grotesk", "Segoe UI", sans-serif
skinparam defaultFontColor #e5e5e5
skinparam defaultFontSize 12
skinparam ArrowColor #38bdf8
skinparam ArrowThickness 1.5

(*) --> "ref sd [Lexical Ingestion & AST Extraction]" as Ref1
--> ===B1===
--> if "Syntax Verified?" then
  -->[clean_ast] "ref sd [Dominators & SSA Fixed-Point]" as Ref2
  --> "ref sd [ROBDD Invariant Saturation]" as Ref3
  --> (*)
else
  -->[syntax_errors] "ref sd [Diagnostic Logging]" as RefErr
  --> (*)
endif

@enduml
