@startuml
skinparam backgroundColor transparent
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName "Space Grotesk", "Segoe UI", sans-serif
skinparam defaultFontColor #e5e5e5
skinparam defaultFontSize 12
skinparam ArrowColor #38bdf8
skinparam ArrowThickness 1.5
skinparam StateBorderColor #38bdf8
skinparam StateBackgroundColor #14171f
skinparam StateFontColor #ffffff

[*] --> Idle : init

state Idle {
  Idle : entry / resetBuffers()
  Idle : do / awaitManifest()
}

Idle --> LexicalIngestion : ingestRequest [validManifest]

state LexicalIngestion {
  LexicalIngestion : entry / mmapSourceFiles()
  LexicalIngestion : do / parallelLexing()
  LexicalIngestion : exit / emitTCA()
}

LexicalIngestion --> CSTReduction : tokensExtracted
LexicalIngestion --> ErrorHandler : syntaxError

state CSTReduction {
  CSTReduction : entry / buildBalancedParentheses()
  CSTReduction : do / computeRMQLCA()
  CSTReduction : exit / emitBPA()
}

CSTReduction --> SymbolResolution : astConstructed

state SymbolResolution {
  SymbolResolution : entry / discoverDeclarations()
  SymbolResolution : do / resolveTypeHierarchy()
  SymbolResolution : exit / emitSTA()
}

SymbolResolution --> DominatorAnalysis : symbolsResolved

state DominatorAnalysis {
  DominatorAnalysis : entry / buildBasicBlocks()
  DominatorAnalysis : do / computeCooperDominators()
  DominatorAnalysis : exit / emitCFA_SSA()
}

DominatorAnalysis --> RobddVerification : ssaCompiled
DominatorAnalysis --> ErrorHandler : cyclicDeadlock

state RobddVerification {
  RobddVerification : entry / buildBDDUniqueTable()
  RobddVerification : do / saturateRobinsonKnuth()
  RobddVerification : exit / emitPSA()
}

RobddVerification --> SCPGSynthesis : bddSaturated

state SCPGSynthesis {
  SCPGSynthesis : entry / synthesizeUMA()
  SCPGSynthesis : do / generateDeterministicUML()
  SCPGSynthesis : exit / emitSCPG()
}

SCPGSynthesis --> VerifiedReady : umlSynthesized [verified]

state VerifiedReady {
  VerifiedReady : entry / notifyStudioReady()
}

VerifiedReady --> [*] : sessionEnd

state ErrorHandler {
  ErrorHandler : entry / captureDiagnostics()
  ErrorHandler : do / formatErrorHUD()
}

ErrorHandler --> Idle : retry / reset()

@enduml
