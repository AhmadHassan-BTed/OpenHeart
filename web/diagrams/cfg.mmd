flowchart TD
    %% Control Flow Graph & Dominator Frontiers
    subgraph CFG_state["Function CFG: state()"]
        BB0_state["Entry Block 0<br/>[Cooper idom: entry]"]
        Gate1_state{"Branch Gate: condition"}
        BB1_state["Then Block 1<br/>Statements Execution"]
        BB2_state["Else/Merge Block 2<br/>Dominance Frontier"]
        BB3_state["Exit Return Block 3"]

        BB0_state --> Gate1_state
        Gate1_state -->|true branch| BB1_state
        Gate1_state -->|false branch| BB2_state
        BB1_state --> BB2_state
        BB2_state --> BB3_state
    end

    subgraph CFG_this["Function CFG: this()"]
        BB0_this["Entry Block 0<br/>[Cooper idom: entry]"]
        Gate1_this{"Branch Gate: condition"}
        BB1_this["Then Block 1<br/>Statements Execution"]
        BB2_this["Else/Merge Block 2<br/>Dominance Frontier"]
        BB3_this["Exit Return Block 3"]

        BB0_this --> Gate1_this
        Gate1_this -->|true branch| BB1_this
        Gate1_this -->|false branch| BB2_this
        BB1_this --> BB2_this
        BB2_this --> BB3_this
    end

    subgraph CFG_path["Function CFG: path()"]
        BB0_path["Entry Block 0<br/>[Cooper idom: entry]"]
        Gate1_path{"Branch Gate: condition"}
        BB1_path["Then Block 1<br/>Statements Execution"]
        BB2_path["Else/Merge Block 2<br/>Dominance Frontier"]
        BB3_path["Exit Return Block 3"]

        BB0_path --> Gate1_path
        Gate1_path -->|true branch| BB1_path
        Gate1_path -->|false branch| BB2_path
        BB1_path --> BB2_path
        BB2_path --> BB3_path
    end

