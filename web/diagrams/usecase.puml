@startuml
skinparam backgroundColor transparent
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName "Space Grotesk", "Segoe UI", sans-serif
skinparam defaultFontColor #e5e5e5
skinparam defaultFontSize 12
skinparam ArrowColor #38bdf8
skinparam ArrowThickness 1.5
skinparam ActorBorderColor #facc15
skinparam ActorBackgroundColor #14171f
skinparam ActorFontColor #ffffff
skinparam UsecaseBorderColor #38bdf8
skinparam UsecaseBackgroundColor #14171f
skinparam UsecaseFontColor #ffffff

actor "Software Engineer" as Dev
actor "Enterprise Architect" as Arch
actor "CI / CD Automation Agent" as CI

package "OpenHeart Web Studio System Boundary" {
  usecase "Ingest Public Repository" as UC_Ingest
  usecase "Compile SCPG Program Graph" as UC_Compile
  usecase "Render Deterministic UML 2.5" as UC_Render
  usecase "Trace Bidirectional AST Code" as UC_Trace
  usecase "Verify ROBDD Path Invariants" as UC_Verify
  usecase "Filter Relationship Layers" as UC_Filter
  usecase "Export Verified UML 2.5 Bundle" as UC_Export
}

Dev --> UC_Ingest
Dev --> UC_Trace
Arch --> UC_Render
Arch --> UC_Filter
CI --> UC_Verify
CI --> UC_Export

UC_Compile ..> UC_Ingest : <<include>>
UC_Render ..> UC_Compile : <<include>>
UC_Verify ..> UC_Compile : <<include>>
UC_Trace ..> UC_Render : <<extend>>
UC_Filter ..> UC_Render : <<extend>>

@enduml
