  act_PauseController --> uc_Image_Trainer_Factory_createTrainer
  usecase "CheckpointManager.createCheckpoint()" as uc_CheckpointManager_createCheckpoint
  act_PauseController --> uc_CheckpointManager_createCheckpoint
  usecase "CheckpointManager.loadCheckpoint()" as uc_CheckpointManager_loadCheckpoint
  act_PauseController --> uc_CheckpointManager_loadCheckpoint
  usecase "CheckpointManager.createCheckpoint()" as uc_CheckpointManager_createCheckpoint
