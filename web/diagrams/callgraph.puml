@startuml
skinparam backgroundColor transparent
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName "Space Grotesk", "Segoe UI", sans-serif
skinparam defaultFontColor #e5e5e5
skinparam defaultFontSize 12
skinparam ArrowColor #38bdf8
skinparam ArrowThickness 1.5
skinparam ClassBorderColor #38bdf8
skinparam ClassBackgroundColor #14171f
skinparam ClassFontColor #ffffff

class "OpenHeart::main()" as Main {
  +main(args: String[]): void
}

class "PipelineRunner::execute()" as Run {
  +execute(manifest: SourceManifest): SCPGArtifact
}

class "IngestionStage::run()" as Ingest {
  +run(m: SourceManifest): TokenCorpusArtifact
}

class "ASTStage::run()" as AST {
  +run(tca: TokenCorpusArtifact): BPASTArtifact
}

class "BPEncoder::traverseRecursive()" as Rec {
  -traverseRecursive(nodeId: int): void
}

class "Phase4Stage::computeDominators()" as Dom {
  +computeDominators(cfg: CFGArtifact): DominatorTree
}

class "CooperAlgorithm::intersect()" as Inter {
  +intersect(b1: int, b2: int): int
}

Main --> Run : static_call
Run --> Ingest : direct_call
Run --> AST : direct_call
AST --> Rec : initial_call
Rec --> Rec : self_recursion
Run --> Dom : direct_call
Dom --> Inter : loop_call

@enduml
