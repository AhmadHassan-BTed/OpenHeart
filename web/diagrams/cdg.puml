@startuml
skinparam backgroundColor transparent
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName "Space Grotesk", "Segoe UI", sans-serif
skinparam defaultFontColor #e5e5e5
skinparam defaultFontSize 12
skinparam ArrowColor #38bdf8
skinparam ArrowThickness 1.5

card "Entry (Root Predicate)" as Entry
card "Pred 1: isManifestValid()" as P1
card "Action: LexicalIngestion" as A1
card "Pred 2: isSyntaxClean()" as P2
card "Action: CSTReduction" as A2
card "Action: LogDiagnostic" as Err

Entry --> P1 : control
P1 --> A1 : [true]
P1 --> Err : [false]
A1 --> P2 : control
P2 --> A2 : [true]
P2 --> Err : [false]

@enduml
