@startuml
skinparam backgroundColor transparent
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName "Space Grotesk", "Segoe UI", sans-serif
skinparam defaultFontColor #e5e5e5
skinparam defaultFontSize 12
skinparam ArrowColor #38bdf8
skinparam ArrowThickness 1.5

card "BB0: Entry" as BB0 {
  v0 = load_param(manifest)
  v1 = validate_manifest(v0)
  branch_if v1 != 0
}

card "BB1: Parse AST" as BB1 {
  v2 = mmap_corpus(v0)
  v3 = build_bp_ast(v2)
  v4 = resolve_symbols(v3)
  branch_if v4.is_valid()
}

card "BB2: Cooper Dominators" as BB2 {
  v5 = compute_rpo(v3)
  v6 = intersect_idom_loop(v5)
  v7 = compute_dominance_frontiers(v6)
}

card "BB3: ROBDD Saturation" as BB3 {
  v8 = phi(v7, null)
  v9 = build_bdd_unique_table(v8)
  v10 = saturate_knuth(v9)
}

card "BB4: Error Diagnostic" as BB4 {
  v11 = format_error_diagnostic()
  log_diagnostic(v11)
}

card "BB5: Exit" as BB5 {
  v12 = phi(v10, v11)
  return v12
}

BB0 --> BB1 : [true]
BB0 --> BB4 : [false]
BB1 --> BB2 : [valid]
BB1 --> BB4 : [invalid]
BB2 --> BB3
BB3 --> BB5
BB4 --> BB5

@enduml
