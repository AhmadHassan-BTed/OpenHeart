title Control Flow Graph (CFG) & Dominator Frontiers

state "Function CFG: state()" as CFG_state {
  state "Entry Block 0\n[Cooper idom: entry]" as BB0 #1e293b
  state "Branch Gate: (condition)" as Gate1 <<choice>>
  state "Then Block 1\n[Statements Execution]" as BB1 #14171f
  state "Else/Merge Block 2\n[Dominance Frontier]" as BB2 #14171f
  state "Exit Return Block 3" as BB3 #0f172a

  [*] --> BB0
  BB0 --> Gate1 : evaluate
  Gate1 --> BB1 : [true branch]
  Gate1 --> BB2 : [false branch]
  BB1 --> BB2 : fallthrough
  BB2 --> BB3 : proceed
  BB3 --> [*] : return
}

state "Function CFG: this()" as CFG_this {
  state "Entry Block 0\n[Cooper idom: entry]" as BB0 #1e293b
