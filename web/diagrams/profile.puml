@startuml
skinparam backgroundColor transparent
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName "Space Grotesk", "Segoe UI", sans-serif
skinparam defaultFontColor #e5e5e5
skinparam defaultFontSize 12
skinparam ArrowColor #38bdf8
skinparam ArrowThickness 1.5
skinparam ClassBorderColor #38bdf8
skinparam ClassBackgroundColor #14171f
skinparam ClassFontColor #ffffff

class "Class" <<metaclass>> {
  +name: String
  +isAbstract: Boolean
  +visibility: VisibilityKind
}

class "Operation" <<metaclass>> {
  +name: String
  +returnType: Type
  +isStatic: Boolean
}

class "Dependency" <<metaclass>> {
  +supplier: NamedElement
  +client: NamedElement
}

class "ArchitecturePattern" <<stereotype>> {
  +category: PatternCategory
  +confidence: Double
  +tier: DomainTier
}

class "DominatorNode" <<stereotype>> {
  +idomRank: Integer
  +dominanceFrontier: List<Integer>
  +cyclomatic: Integer
}

class "BDDSaturated" <<stereotype>> {
  +satCount: BigInteger
  +uniqueNodeCount: Integer
  +invariantsVerified: Boolean
}

ArchitecturePattern --|> Class : <<extension>>
DominatorNode --|> Operation : <<extension>>
BDDSaturated --|> Dependency : <<extension>>

@enduml
