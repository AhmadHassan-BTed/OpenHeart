@startuml
skinparam backgroundColor transparent
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName "Space Grotesk", "Segoe UI", sans-serif
skinparam defaultFontColor #e5e5e5
skinparam defaultFontSize 12
skinparam ArrowColor #38bdf8
skinparam ArrowThickness 1.5

robust "Compiler Core" as CC
concise "Memory Pool" as MP
robust "Parallel Workers" as PW
concise "Disk I/O" as DIO

@0
CC is IDLE
MP is ALLOCATED_64MB
PW is DORMANT
DIO is IDLE

@10
CC is PHASE1_LEXING
MP is MMAP_ACTIVE
PW is PARALLEL_FAN_OUT
DIO is READ_MANIFEST

@30
CC is PHASE2_BP_AST

@60
CC is PHASE3_SYMBOLS
MP is ARENA_SCRATCH

@100
CC is PHASE4_DOMINATORS
PW is COOPER_FIXED_POINT

@150
CC is PHASE5_SSA

@200
CC is PHASE8_ROBDD
MP is BDD_DEDUP_CACHE
PW is PARALLEL_ROBDD_APPLY

@260
CC is PHASE10_SCPG
DIO is WRITE_SCPG_BINARY

@280
CC is READY
MP is RETENTION_CLEARED
PW is JOINED
DIO is FLUSHED

@enduml
