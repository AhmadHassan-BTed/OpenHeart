@startuml
skinparam backgroundColor transparent
skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName "Space Grotesk", "Segoe UI", sans-serif
skinparam defaultFontColor #e5e5e5
skinparam defaultFontSize 12
skinparam ArrowColor #38bdf8
skinparam ArrowThickness 1.5
skinparam packageStyle rectangle
skinparam PackageBorderColor #facc15
skinparam PackageBackgroundColor #0f141c
skinparam PackageFontColor #facc15
skinparam ClassBorderColor #38bdf8
skinparam ClassBackgroundColor #14171f
skinparam ClassHeaderBackgroundColor #1e2433
skinparam ClassFontColor #ffffff
skinparam ObjectBorderColor #38bdf8
skinparam ObjectBackgroundColor #14171f
skinparam ObjectFontColor #ffffff
skinparam ComponentBorderColor #38bdf8
skinparam ComponentBackgroundColor #14171f
skinparam ComponentFontColor #ffffff
skinparam NodeBorderColor #38bdf8
skinparam NodeBackgroundColor #14171f
skinparam NodeFontColor #ffffff
skinparam StateBorderColor #38bdf8
skinparam StateBackgroundColor #14171f
skinparam StateFontColor #ffffff
skinparam ActivityBorderColor #38bdf8
skinparam ActivityBackgroundColor #14171f
skinparam ActivityFontColor #ffffff
skinparam SequenceLifeLineBorderColor #38bdf8
skinparam SequenceLifeLineBackgroundColor #14171f
skinparam SequenceGroupBorderColor #facc15
skinparam SequenceGroupBackgroundColor #0f141c
skinparam SequenceGroupFontColor #facc15
skinparam ParticipantBorderColor #38bdf8
skinparam ParticipantBackgroundColor #14171f
skinparam ParticipantFontColor #ffffff
skinparam ActorBorderColor #facc15
skinparam ActorBackgroundColor #14171f
skinparam ActorFontColor #ffffff
skinparam UsecaseBorderColor #38bdf8
skinparam UsecaseBackgroundColor #14171f
skinparam UsecaseFontColor #ffffff


package "com" as pkg_com {

  package "com.patterns" as pkg_com_patterns {

    package "com.patterns.behavioral" as pkg_com_patterns_behavioral {

      package "com.patterns.behavioral.observer" as pkg_com_patterns_behavioral_observer {
        class NewsAgency <<Decorator>> {
          +news : 
          +observers : 
          +setNews() : 
          +attach() : 
          +detach() : 
          +notifyObservers() : 
        }
        class NewsChannel <<Decorator>> {
          +news : 
          +update() : 
        }
        interface Observer {
          +update() : 
        }
        interface Subject {
          +attach() : 
          +detach() : 
          +notifyObservers() : 
        }
      }

      package "com.patterns.behavioral.strategy" as pkg_com_patterns_behavioral_strategy {
        class CreditCardStrategy <<State>> {
          +name : 
          +cardNumber : 
          +CreditCardStrategy() : 
          +pay() : 
        }
        interface PaymentStrategy <<State>> {
          +pay() : 
        }
        class PaypalStrategy <<State>> {
          +emailId : 
          +PaypalStrategy() : 
          +pay() : 
        }
        class ShoppingCart <<Decorator>> {
          +paymentStrategy : PaymentStrategy
          +setPaymentStrategy() : 
          +checkout() : 
        }
      }

      package "com.patterns.behavioral.templatemethod" as pkg_com_patterns_behavioral_templatemethod {
        class CsvDataMiner {
          +openFile() : 
          +extractData() : 
          +parseData() : 
        }
        class DataMiner {
          +mine() : 
          +openFile() : 
          +extractData() : 
          +parseData() : 
          +closeFile() : 
        }
        class PdfDataMiner {
          +openFile() : 
          +extractData() : 
          +parseData() : 
        }
      }
    }

    package "com.patterns.creational" as pkg_com_patterns_creational {

      package "com.patterns.creational.builder" as pkg_com_patterns_creational_builder {
        class Computer <<Decorator>> {
          +cpu : 
          +ram : 
          +storage : 
          +graphicsCardEnabled : 
          +setCpu() : 
          +setRam() : 
          +setStorage() : 
          +setGraphicsCardEnabled() : 
          +getCpu() : 
          +getRam() : 
          +getStorage() : 
          +isGraphicsCardEnabled() : 
        }
        class ComputerBuilder <<Builder>> {
          +computer : Computer
          +ComputerBuilder() : 
          +buildCpu() : ComputerBuilder
          +buildRam() : ComputerBuilder
          +buildStorage() : ComputerBuilder
          +setGraphicsCard() : ComputerBuilder
          +build() : Computer
        }
        class Director {
          +constructGamingComputer() : Computer
        }
      }

      package "com.patterns.creational.factory" as pkg_com_patterns_creational_factory {
        class Logistics {
          +planDelivery() : 
          +createTransport() : Transport
        }
        class RoadLogistics {
          +createTransport() : Transport
        }
        class SeaLogistics {
          +createTransport() : Transport
        }
        class Ship {
          +deliver() : 
        }
        interface Transport {
          +deliver() : 
        }
        class Truck {
          +deliver() : 
        }
      }

      package "com.patterns.creational.singleton" as pkg_com_patterns_creational_singleton {
        class DatabaseConnectionPool <<Singleton>> {
          +instance : DatabaseConnectionPool
          +maxConnections : 
          +isInitialized : 
          +DatabaseConnectionPool() : 
          +getInstance() : DatabaseConnectionPool
          +executeQuery() : 
        }
      }
    }

    package "com.patterns.structural" as pkg_com_patterns_structural {

      package "com.patterns.structural.adapter" as pkg_com_patterns_structural_adapter {
        interface AdvancedMediaPlayer {
          +playVlc() : 
          +playMp4() : 
        }
        class AudioPlayer <<Decorator>> {
          +mediaAdapter : MediaAdapter
          +play() : 
        }
        class MediaAdapter <<Decorator>> {
          +advancedMusicPlayer : AdvancedMediaPlayer
          +MediaAdapter() : 
          +play() : 
        }
        interface MediaPlayer {
          +play() : 
        }
        class Mp4Player {
          +playVlc() : 
          +playMp4() : 
        }
        class VlcPlayer {
          +playVlc() : 
          +playMp4() : 
        }
      }

      package "com.patterns.structural.decorator" as pkg_com_patterns_structural_decorator {
        interface Beverage {
          +getDescription() : 
          +cost() : 
        }
        class CondimentDecorator <<Decorator>> {
          +beverage : Beverage
          +CondimentDecorator() : 
          +getDescription() : 
        }
        class Espresso {
          +getDescription() : 
          +cost() : 
        }
        class Mocha {
          +Mocha() : 
          +getDescription() : 
          +cost() : 
        }
        class Whip {
          +Whip() : 
          +getDescription() : 
          +cost() : 
        }
      }

      package "com.patterns.structural.facade" as pkg_com_patterns_structural_facade {
        class AudioMixer {
          +fix() : 
        }
        class BitrateReader {
          +read() : 
        }
        class VideoConversionFacade <<Decorator>> {
          +audioMixer : AudioMixer
          +bitrateReader : BitrateReader
          +convertVideo() : 
        }
      }
    }
  }
}

AudioPlayer o-- MediaAdapter
AudioPlayer ..|> MediaPlayer
ComputerBuilder *-- Computer
CondimentDecorator o-- Beverage
CondimentDecorator ..|> Beverage
CreditCardStrategy ..|> PaymentStrategy
CsvDataMiner --|> DataMiner
Espresso ..|> Beverage
MediaAdapter o-- AdvancedMediaPlayer
MediaAdapter ..|> MediaPlayer
Mocha --|> CondimentDecorator
Mp4Player ..|> AdvancedMediaPlayer
NewsAgency ..|> Subject
NewsAgency o-- Observer
NewsChannel ..|> Observer
PaypalStrategy ..|> PaymentStrategy
PdfDataMiner --|> DataMiner
RoadLogistics --|> Logistics
SeaLogistics --|> Logistics
Ship ..|> Transport
ShoppingCart o-- PaymentStrategy
Truck ..|> Transport
VideoConversionFacade *-- AudioMixer
VideoConversionFacade *-- BitrateReader
VlcPlayer ..|> AdvancedMediaPlayer
Whip --|> CondimentDecorator

@enduml
