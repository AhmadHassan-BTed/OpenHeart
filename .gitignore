# ==============================================================================
# OpenHeart (.gitignore) — Comprehensive Workspace Configuration
# ==============================================================================
# A leading `/` anchors a pattern to the repository root. Build and output
# directories are anchored so that source and fixture trees which contain a
# directory of the same name stay visible to git: `src/lang/build/` (the
# compile_commands / CMake / MSBuild readers), a CMake fixture's `build/`, a Java
# package named `out` or `env`.

# ── 1. Rust / Cargo Build Targets & Artifacts ──
/target/
**/*.rs.bk
*.pdb

# ── 2. Node / Frontend Build & Logs ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.parcel-cache/
.next/
/build/

# ── 3. Python Bytecode, Caches & Virtual Environments ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
/ENV/
/env/
*.egg-info/

# ── 4. SCPG Compiler Pipeline Binary Artifacts (Phases 1–10) ──
*.tca
*.bpa
*.sta
*.cfa
*.ssa
*.cga
*.tra
*.psa
*.uma
*.scpg

# ── 5. Output & Benchmark Cache Directories ──
# Analysis output written next to the repository root by the CLI, the examples
# (`openheart analyze ... ./output_patterns`) and the Python harnesses.
/tmp/
/temp/
/out/
/out_*/
/output_*/
*_output/
*_output_answer/
/target_repos/
/sample_project/
/sample_projects/

# ── 6. Logs & Temporary Dump Files ──
*.log
*.tmp
*.dump
*.bin.png.txt
*.png.txt

# ── 6b. Quality Gates, Profiling & Release Packaging (see Makefile) ──
# cargo-llvm-cov / -Cinstrument-coverage output
lcov.info
*.profraw
*.profdata
# cargo-mutants
mutants.out/
mutants.out.old/
# cargo-fuzz build output, generated corpora and crash reproducers
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/
# perf, samply and cargo-flamegraph captures from `make profile-build` binaries
perf.data
perf.data.old
/flamegraph.svg
# `make dist` release archives and their SHA-256 files
/dist/

# ── 7. Media Storage & Scratch Workspaces ──
.tempmediaStorage/
/scratch/
docs/assets/*.webp
docs/assets/*.mp4

# ── 8. Operating System Metadata ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── 9. IDE & Editor Configurations ──
# Ignore the directory's contents, not the directory itself: git never descends
# into an excluded directory, so negations below `.vscode/` would have no effect.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
.vs/
cmake-build-*/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak
.zed/
.fleet/
.project
.classpath
.settings/

# ── 10. Environment Configurations & Secrets ──
.env
.env.*
!.env.example
