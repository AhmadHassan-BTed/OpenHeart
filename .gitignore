# ==============================================================================
# OpenHeart (.gitignore) — Comprehensive Workspace Configuration
# ==============================================================================

# ── 1. Rust / Cargo Build Targets & Artifacts ──
/target/
**/*.rs.bk
*.pdb

# ── 2. Node / Frontend Build & Logs ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.parcel-cache/
.next/
dist/
build/

# ── 3. Python Bytecode, Caches & Virtual Environments ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/
*.egg-info/

# ── 4. SCPG Compiler Pipeline Binary Artifacts (Phases 1–10) ──
*.tca
*.bpa
*.sta
*.cfa
*.ssa
*.cga
*.tra
*.psa
*.uma
*.scpg

# ── 5. Output & Benchmark Cache Directories ──
tmp/
temp/
out/
out_*/
*_output/
*_output_answer/
output_diagrams/
target_repos/
sample_project/
big_project_output/
huge_output/
scpg_output/
fractal_android_output/
fractal_android_output_answer/

# ── 6. Logs & Temporary Dump Files ──
*.log
*.tmp
*.dump
*.bin.png.txt
*.png.txt

# ── 7. Media Storage & Scratch Workspaces ──
.tempmediaStorage/
scratch/

# ── 8. Operating System Metadata ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── 9. IDE & Editor Configurations ──
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak
.zed/
.fleet/
.project
.classpath
.settings/

# ── 10. Environment Configurations & Secrets ──
.env
.env.*
!.env.example
