# OpenHeart Environment Configuration Example
# Copy this file to .env for local development override.

# Logging Level (error, warn, info, debug, trace)
RUST_LOG=info

# Output Directory for Generated .tca Artifacts
OPENHEART_ARTIFACT_DIR=./target/artifacts

# Maximum Memory Allocation Limit (in MB)
OPENHEART_MAX_MEMORY_MB=2048

# Number of Parallel Worker Threads (0 = Auto-detect CPU cores)
OPENHEART_NUM_THREADS=0

# Enable Invariant Integrity Assertions (true/false)
OPENHEART_STRICT_INVARIANTS=true
