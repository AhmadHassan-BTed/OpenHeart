# OpenHeart Environment Configuration Example
# Copy this file to .env for local development override. run.sh and run.bat load .env
# (variables already set in the shell win); the openheart binary itself reads only the
# process environment. Every variable below is read by the code; command-line options
# take precedence over them.

# ── Logging ──────────────────────────────────────────────────────────────────
# Console log level: off, error, warn, info, debug, trace. When unset, an env_logger-style
# RUST_LOG (e.g. RUST_LOG=openheart=debug) is honored instead.
OPENHEART_LOG=info
# Threshold for the persistent and session log files (default: info)
# OPENHEART_FILE_LOG=debug
# Rotate the persistent log beyond this many bytes (default 16 MiB; 0 = never)
# OPENHEART_LOG_MAX_BYTES=16777216

# ── CLI: openheart analyze ───────────────────────────────────────────────────
# Default output directory when none is given on the command line
OPENHEART_ARTIFACT_DIR=./openheart_output

# ── Source selection limits (CLI and server) ─────────────────────────────────
# Maximum number of source files per analysis (hard ceiling 65536)
OPENHEART_MAX_FILES=20000
# Source files larger than this many KiB are skipped and reported
OPENHEART_MAX_FILE_KB=4096
# Maximum combined size of the selected sources, in MiB
OPENHEART_MAX_SOURCE_MB=256
# Stack reserved for the pipeline thread, in MiB (deep CFG/SSA recursion needs room)
OPENHEART_STACK_MB=256
# Phase 1 parser worker threads (0 = one per available core)
OPENHEART_NUM_THREADS=0
# Reproducible builds: fixed timestamp embedded in the .scpg header
# SOURCE_DATE_EPOCH=1700000000

# ── Server: openheart server ─────────────────────────────────────────────────
# Interface to bind. 127.0.0.1 keeps the server local; any other address exposes it to
# the network and makes an access token mandatory. HOST is read when this is unset.
OPENHEART_HOST=127.0.0.1
# Port to listen on. PORT is read when this is unset.
OPENHEART_PORT=8080
# Access token for every route except /api/health. Required (and generated when unset)
# on non-loopback binds. Browsers log in once through http://<host>:<port>/?token=<token>.
# OPENHEART_API_TOKEN=
# Extra host names accepted in the Host header (loopback names and IP literals are
# always accepted), comma-separated
# OPENHEART_ALLOWED_HOSTS=openheart.internal
# Origins allowed to call the API cross-origin (CORS), comma-separated
# OPENHEART_CORS_ORIGINS=https://example.github.io
# Directory for cached clones (repos/) and per-analysis sessions (sessions/)
OPENHEART_WORKSPACE=./target_repos
# Web studio directory
OPENHEART_WEB_ROOT=./web
# Sample source trees served by /api/source, separated like PATH (':' or ';' on Windows)
OPENHEART_SOURCE_ROOTS=./examples/test_patterns_codebase
# Directory whose sub-directories may be analyzed by name with {"local_repo": "<name>"}
# OPENHEART_LOCAL_REPOS=./datasets
# Server-side git clone of https://github.com repositories (default: enabled only when
# bound to a loopback interface)
# OPENHEART_ALLOW_CLONE=true
# Time and size limits for one clone
OPENHEART_CLONE_TIMEOUT_SECS=300
OPENHEART_MAX_REPO_MB=1024
# Time a synchronous /api/analyze request waits before answering 504
OPENHEART_ANALYSIS_TIMEOUT_SECS=600
# Connection worker threads, concurrent pipelines, and completed sessions kept on disk
OPENHEART_WORKERS=8
OPENHEART_MAX_ANALYSES=2
OPENHEART_MAX_SESSIONS=8
# Largest accepted request body, in KiB
OPENHEART_MAX_BODY_KB=64
